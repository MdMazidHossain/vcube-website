<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Careers — Join VCUBE Soft and Tech Limited</title>
  <meta name="description" content="A Brighter Tomorrow, Together. At VCUBE, we believe in meaningful work, continuous learning, and opportunities to grow.">
  <link rel="icon" type="image/png" href="assets/images/vcube-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/responsive.css">
</head>
<body>

  <header class="navbar" id="navbar">
    <div class="nav-container">
      <a href="index.html" class="logo">
        <img src="assets/images/vcube-logo.png" alt="VCUBE" class="logo-img">
      </a>
      <nav class="nav-links" id="navLinks">
        <a href="index.html#solutions">Solutions</a>
        <a href="index.html#edge">About</a>
        <a href="careers.html" class="active">Careers</a>
        <a href="index.html#contact">Contact Us</a>
      </nav>
      <a href="index.html#contact" class="btn btn-primary nav-cta">
        Get Started <i class="fas fa-arrow-right"></i>
      </a>
      <button class="hamburger" id="hamburger" aria-label="Menu">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </header>

  <!-- HERO -->
  <section class="careers-hero">
    <div class="hero-bg">
      <div class="hero-grid"></div>
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
    </div>
    <div class="container" style="position: relative; z-index: 2;">
      <div class="careers-tagline">People / Ideas / Impact</div>
      <h1 class="careers-title">
        A Brighter Tomorrow,<br>
        <span class="gradient-text">Together.</span>
      </h1>
      <p class="careers-desc">
        At Vcube, we believe in meaningful work, continuous learning and opportunities
        to grow — for a better tomorrow.
      </p>
      <div class="hero-buttons" style="justify-content: center; margin-top: 32px;">
        <a href="#open-positions" class="btn btn-primary">
          View Open Positions <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- OPEN POSITIONS -->
  <section class="positions" id="open-positions">
    <div class="container">
      <div class="section-header center">
        <span class="section-tag">Open Positions</span>
        <h2 class="section-title">Current Opportunities</h2>
        <p class="section-subtitle">
          Join a team that values curiosity, craftsmanship and real-world impact.
          Explore our current openings and find your place at Vcube.
        </p>
      </div>

      <div class="positions-list">
        <!-- Position 1 -->
        <div class="position-card">
          <div class="pos-icon"><i class="fas fa-user-tie"></i></div>
          <div class="pos-content">
            <h3>Associate — Admin & People Op</h3>
            <div class="pos-meta">
              <span><i class="fas fa-building"></i> Vcube Soft And Tech</span>
              <span><i class="fas fa-location-dot"></i> Dhaka, Bangladesh</span>
              <span><i class="fas fa-clock"></i> Full-time</span>
            </div>
            
          </div>
          <a href="BdJOBS_LINK_HERE" target="_blank" rel="noreferrer" class="pos-apply">
            Apply <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <!-- Position 2 -->
        <div class="position-card">
          <div class="pos-icon"><i class="fas fa-users-gear"></i></div>
          <div class="pos-content">
            <h3>Executive — HR And Admin</h3>
            <div class="pos-meta">
              <span><i class="fas fa-building"></i> Vcube Soft And Tech</span>
              <span><i class="fas fa-location-dot"></i> Dhaka, Bangladesh</span>
              <span><i class="fas fa-clock"></i> Full-time</span>
            </div>
            
          </div>
          <a href="BdJOBS_LINK_HERE" target="_blank" rel="noreferrer" class="pos-apply">
            Apply <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <!-- Position 3 -->
        <div class="position-card">
          <div class="pos-icon"><i class="fas fa-graduation-cap"></i></div>
          <div class="pos-content">
            <h3>Management Trainee Officer (MTO)</h3>
            <div class="pos-meta">
              <span><i class="fas fa-building"></i> Vcube Soft And Tech</span>
              <span><i class="fas fa-location-dot"></i> Dhaka, Bangladesh</span>
              <span><i class="fas fa-clock"></i> Full-time</span>
            </div>
            
          </div>
          <a href="BdJOBS_LINK_HERE" target="_blank" rel="noreferrer" class="pos-apply">
            Apply <i class="fas fa-external-link-alt"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY VCUBE -->
  <section class="why-vcube">
    <div class="container">
      <div class="section-header center">
        <span class="section-tag">Why Vcube</span>
        <h2 class="section-title">Meaningful Work. Real Growth.</h2>
        <p class="section-subtitle">
          We create an environment where people can do their best work. Whether you're
          just starting or bringing years of experience, you'll find opportunities to
          learn, contribute and make an impact.
        </p>
      </div>

      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon"><i class="fas fa-graduation-cap"></i></div>
          <h3>Learn Continuously</h3>
          <p>Access to new ideas, skills and technologies.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><i class="fas fa-arrow-trend-up"></i></div>
          <h3>Work With Purpose</h3>
          <p>Build solutions that create real value.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><i class="fas fa-handshake"></i></div>
          <h3>A Supportive Culture</h3>
          <p>Collaborative, respectful and people-first.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CV SUBMISSION -->
  <section class="apply-section" id="apply">
    <div class="container">
      <div class="apply-wrap">
        <div class="apply-info">
          <span class="section-tag">Don't See A Suitable Position?</span>
          <h2 class="section-title">
            We'd Still Love<br>
            to Hear From You.
          </h2>
          <p class="section-subtitle" style="margin-bottom: 32px;">
            Share your CV with us and we'll keep it on file for future opportunities.
          </p>

          <div class="apply-contact-box">
            <div class="apply-contact-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="apply-contact-text">
              <span>Submit Your CV</span>
              <a href="mailto:hr@vcube.xyz">hr@vcube.xyz</a>
            </div>
          </div>
        </div>

        <form class="apply-form" name="careers" method="POST" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" action="/thank-you.html">
          <input type="hidden" name="form-name" value="careers" />
          <p hidden><label>Don't fill: <input name="bot-field" /></label></p>

          <h3 class="form-title">Submit Your CV</h3>

          <div class="form-row">
            <div class="form-group">
              <label>Full Name *</label>
              <input type="text" name="full_name" placeholder="Your full name" required>
            </div>
            <div class="form-group">
              <label>Phone Number *</label>
              <input type="tel" name="phone" placeholder="+880 1700 000000" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Email Address *</label>
              <input type="email" name="email" placeholder="you@example.com" required>
            </div>
            <div class="form-group">
              <label>Position of Interest *</label>
              <select name="position" required>
                <option value="">Select position...</option>
                <option value="associate-admin">Associate — Admin & People Op</option>
                <option value="executive-hr">Executive — HR And Admin</option>
                <option value="mto">Management Trainee Officer (MTO)</option>
                <option value="general">General Application</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Experience Level *</label>
              <select name="experience" required>
                <option value="">Select experience...</option>
                <option value="fresher">Fresher (0–1 year)</option>
                <option value="junior">Junior (1–3 years)</option>
                <option value="mid">Mid-Level (3–5 years)</option>
                <option value="senior">Senior (5+ years)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Expected Salary (BDT/month)</label>
              <input type="text" name="salary" placeholder="e.g. 40,000">
            </div>
          </div>

          <div class="form-group">
            <label>Portfolio / LinkedIn URL</label>
            <input type="url" name="portfolio" placeholder="https://linkedin.com/in/yourprofile">
          </div>

          <div class="form-group">
            <label>Upload CV (PDF / DOC / DOCX) *</label>
            <div class="file-upload">
              <input type="file" name="cv" id="cvUpload" accept=".pdf,.doc,.docx" required>
              <label for="cvUpload" class="file-label">
                <i class="fas fa-cloud-upload-alt"></i>
                <span id="fileName">Click to upload or drag & drop</span>
                <small>PDF, DOC, DOCX — Max 5 MB</small>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label>Cover Letter / Why Vcube?</label>
            <textarea name="cover_letter" rows="5" placeholder="Tell us why you want to join Vcube..."></textarea>
          </div>

          <div class="form-check">
            <input type="checkbox" name="consent" id="consent" required>
            <label for="consent">I confirm the information is accurate and consent to Vcube processing my application.</label>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Submit Application <i class="fas fa-paper-plane"></i>
          </button>
        </form>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="index.html" class="logo">
            <img src="assets/images/vcube-logo.png" alt="VCUBE" class="logo-img">
          </a>
          <p>Unified BPO & digital solutions engineered for global scale.</p>
        </div>
        <div class="footer-col">
          <h4>Solutions</h4>
          <a href="index.html#solutions">Back Office</a>
          <a href="index.html#solutions">Data Entry</a>
          <a href="index.html#solutions">SEO</a>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <a href="index.html#edge">About</a>
          <a href="careers.html">Careers</a>
          <a href="index.html#contact">Contact Us</a>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <a href="mailto:info@vcube.xyz"><i class="fas fa-envelope"></i> info@vcube.xyz</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 VCUBE Soft and Tech Limited. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="js/main.js"></script>
</body>
</html>