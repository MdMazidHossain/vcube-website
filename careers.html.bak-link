<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Careers — Join VCUBE Soft and Tech Limited</title>
  <meta name="description" content="A Brighter Tomorrow, Together. At VCUBE, we believe in meaningful work, continuous learning, and opportunities to grow.">
  <link rel="icon" type="image/png" href="assets/images/vcube-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="css/style.css">
  <link rel="stylesheet" href="css/responsive.css">
</head>
<body>

  <header class="navbar" id="navbar">
    <div class="nav-container">
      <a href="index.html" class="logo" aria-label="VCUBE Home">
        <img src="assets/images/vcube-logo.png" alt="VCUBE Logo" class="logo-img" loading="eager">
      </a>
      <nav class="nav-links" id="navLinks">
        <a href="index.html#solutions">Solutions</a>
        <a href="index.html#edge">About</a>
        <a href="careers.html" class="active">Careers</a>
        <a href="index.html#contact">Contact Us</a>
      </nav>
      <a href="index.html#contact" class="btn btn-primary nav-cta">
        Get Started <i class="fas fa-arrow-right"></i>
      </a>
      <button class="hamburger" id="hamburger" aria-label="Menu">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </header>

  <!-- HERO -->
  <section class="careers-hero">
    <div class="hero-bg">
      <div class="hero-grid"></div>
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
    </div>
    <div class="container" style="position: relative; z-index: 2;">
      <div class="careers-tagline">People / Ideas / Impact</div>
      <h1 class="careers-title">
        A Brighter Tomorrow,<br>
        <span class="gradient-text">Together.</span>
      </h1>
      <p class="careers-desc">
        At Vcube, we believe in meaningful work, continuous learning and opportunities
        to grow — for a better tomorrow.
      </p>
      <div class="hero-buttons" style="justify-content: center; margin-top: 32px;">
        <a href="#open-positions" class="btn btn-primary">
          View Open Positions <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- OPEN POSITIONS -->
  <section class="positions" id="open-positions">
    <div class="container">
      <div class="section-header center">
        <span class="section-tag">Open Positions</span>
        <h2 class="section-title">Current Opportunities</h2>
        <p class="section-subtitle">
          Join a team that values curiosity, craftsmanship and real-world impact.
          Explore our current openings and find your place at Vcube.
        </p>
      </div>

      <div class="positions-list">
        <!-- Position 1 -->
        <div class="position-card">
          <div class="pos-icon"><i class="fas fa-user-tie"></i></div>
          <div class="pos-content">
            <h3>Associate — Admin & People Op</h3>
            <div class="pos-meta">
              <span><i class="fas fa-building"></i> Vcube Soft And Tech</span>
              <span><i class="fas fa-location-dot"></i> Dhaka, Bangladesh</span>
              <span><i class="fas fa-clock"></i> Full-time</span>
            </div>
            
          </div>
          <a href="https://bdjobs.com/h/details/1527850?ln=1" target="_blank" rel="noreferrer" class="pos-apply">
            Apply <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <!-- Position 2 -->
        <div class="position-card">
          <div class="pos-icon"><i class="fas fa-users-gear"></i></div>
          <div class="pos-content">
            <h3>Executive — HR And Admin</h3>
            <div class="pos-meta">
              <span><i class="fas fa-building"></i> Vcube Soft And Tech</span>
              <span><i class="fas fa-location-dot"></i> Dhaka, Bangladesh</span>
              <span><i class="fas fa-clock"></i> Full-time</span>
            </div>
            
          </div>
          <a href="BdJOBS_LINK_HERE" target="_blank" rel="noreferrer" class="pos-apply">
            Apply <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <!-- Position 3 -->
        <div class="position-card">
          <div class="pos-icon"><i class="fas fa-graduation-cap"></i></div>
          <div class="pos-content">
            <h3>Management Trainee Officer (MTO)</h3>
            <div class="pos-meta">
              <span><i class="fas fa-building"></i> Vcube Soft And Tech</span>
              <span><i class="fas fa-location-dot"></i> Dhaka, Bangladesh</span>
              <span><i class="fas fa-clock"></i> Full-time</span>
            </div>
            
          </div>
          <a href="BdJOBS_LINK_HERE" target="_blank" rel="noreferrer" class="pos-apply">
            Apply <i class="fas fa-external-link-alt"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY VCUBE -->
  <section class="why-vcube">
    <div class="container">
      <div class="section-header center">
        <span class="section-tag">Why Vcube</span>
        <h2 class="section-title">Meaningful Work. Real Growth.</h2>
        <p class="section-subtitle">
          We create an environment where people can do their best work. Whether you're
          just starting or bringing years of experience, you'll find opportunities to
          learn, contribute and make an impact.
        </p>
      </div>

      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon"><i class="fas fa-graduation-cap"></i></div>
          <h3>Learn Continuously</h3>
          <p>Access to new ideas, skills and technologies.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><i class="fas fa-arrow-trend-up"></i></div>
          <h3>Work With Purpose</h3>
          <p>Build solutions that create real value.</p>
        </div>

        <div class="why-card">
          <div class="why-icon"><i class="fas fa-handshake"></i></div>
          <h3>A Supportive Culture</h3>
          <p>Collaborative, respectful and people-first.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CV SUBMISSION -->
  <!-- ═══ CV SUBMISSION ═══ -->
  <section class="apply-section" id="apply">
    <div class="container">
      <div class="section-header center">
        <span class="section-tag">Don't See A Suitable Position?</span>
        <h2 class="section-title">We'd Still Love to Hear From You.</h2>
        <p class="section-subtitle">
          Share your CV with us and we'll keep it on file for future opportunities.
        </p>
      </div>

      <div class="cv-options-wrap">
        <!-- Option 1: Google Form -->
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSdSTPshbBg60llwsU6dkdQ2GS3k0Eei-Ls_svC4j-k6yAOx4g/viewform"
           target="_blank"
           rel="noreferrer"
           class="cv-option-card cv-option-form">
          <div class="cv-option-icon">
            <i class="fas fa-file-circle-plus"></i>
          </div>
          <div class="cv-option-content">
            <h3>Open Application Form</h3>
            <p>Fill out our quick form and upload your CV.</p>
            <span class="cv-option-btn">
              Open Form <i class="fas fa-arrow-right"></i>
            </span>
          </div>
          <div class="cv-option-arrow">
            <i class="fas fa-external-link-alt"></i>
          </div>
        </a>

        <!-- Option 2: Email -->
        <a href="mailto:hr@vcube.xyz?subject=CV Submission — VCUBE"
           class="cv-option-card cv-option-email">
          <div class="cv-option-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <div class="cv-option-content">
            <h3>Submit Your CV</h3>
            <p>Send your CV directly to our HR team.</p>
            <span class="cv-option-btn">
              hr@vcube.xyz <i class="fas fa-arrow-right"></i>
            </span>
          </div>
          <div class="cv-option-arrow">
            <i class="fas fa-paper-plane"></i>
          </div>
        </a>
      </div>

      <p class="cv-options-note">
        <i class="fas fa-info-circle"></i>
        Both options are monitored by our HR team — CVs are reviewed for future openings.
      </p>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="index.html" class="logo">
            <img src="assets/images/vcube-logo.png" alt="VCUBE" class="logo-img">
          </a>
          <p>Unified BPO & digital solutions engineered for global scale.</p>
        </div>
        <div class="footer-col">
          <h4>Solutions</h4>
          <a href="index.html#solutions">Back Office</a>
          <a href="index.html#solutions">Data Entry</a>
          <a href="index.html#solutions">SEO</a>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <a href="index.html#edge">About</a>
          <a href="careers.html">Careers</a>
          <a href="index.html#contact">Contact Us</a>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <a href="mailto:info@vcube.xyz"><i class="fas fa-envelope"></i> info@vcube.xyz</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">
          © 2026 VCUBE Soft and Tech Limited. All rights reserved. 
          <span class="developer-credit">· <a href="https://github.com/mazid-dev" target="_blank" rel="noreferrer">Md Mazid Hossain</a></span>
        </p>
        
      </div>
    </div>
  </footer>

  <script src="js/main.js"></script>
</body>
</html>