<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VCUBE Soft and Tech Limited — Scale Globally with Unified BPO & Digital Solutions</title>

    <link rel="icon" type="image/x-icon" href="assets/images/favicon.ico?v=10">
    <link rel="icon" type="image/png" sizes="32x32" href="assets/images/favicon-32x32.png?v=10">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/images/favicon-16x16.png?v=10">

    <meta name="description" content="VCUBE integrates mission-critical back-office workflows, omnichannel growth marketing pipelines, and cutting-edge visual engineering into your everyday business ecosystem.">
    <meta name="keywords" content="VCUBE Soft and Tech, BPO, Digital Solutions, Back Office Support, SEO, Social Media Management, Real Estate Outsourcing, 3D Visualization, Bangladesh">
    <meta name="author" content="VCUBE Soft and Tech Limited">
    <meta name="robots" content="index, follow">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --primary: #0B192C;
            --accent: #008DDA;
            --accent-light: #41C9E2;
            --bg-light: #F8FAFC;
            --text-dark: #0F172A;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --white: #ffffff;
            --gradient-1: linear-gradient(135deg, #008DDA 0%, #41C9E2 100%);
            --gradient-2: linear-gradient(135deg, #0B192C 0%, #1E3A5F 100%);
            --shadow-md: 0 4px 20px rgba(0,0,0,0.06);
            --shadow-lg: 0 20px 50px rgba(0,0,0,0.1);
            --shadow-glow: 0 8px 32px rgba(0, 141, 218, 0.25);
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-dark);
            line-height: 1.6;
            background: #fff;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4 { font-family: 'Space Grotesk', 'Inter', sans-serif; letter-spacing: -0.02em; }

        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: var(--gradient-1); border-radius: 5px; }

        /* ============ NAVBAR (FULL WHITE) ============ */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            background: #ffffff;
            border-bottom: 1px solid #E2E8F0;
            transition: all 0.3s ease;
        }
        header.scrolled {
            box-shadow: 0 4px 30px rgba(0,0,0,0.05);
        }
        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 28px;
            background: #ffffff;
        }

        /* Logo — NO background box, transparent */
        .logo {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
            background: transparent;
        }
        .logo img {
            height: 44px;
            width: auto;
            display: block;
            transition: transform 0.3s ease;
        }
        .logo:hover img { transform: scale(1.03); }

        nav ul { display: flex; list-style: none; align-items: center; gap: 6px; }
        nav ul li a {
            text-decoration: none;
            color: var(--primary);
            font-weight: 500;
            font-size: 15px;
            padding: 10px 16px;
            border-radius: 8px;
            transition: all 0.25s ease;
        }
        nav ul li a:hover { color: var(--accent); background: rgba(0, 141, 218, 0.06); }
        .cta-nav-btn {
            background: var(--gradient-1) !important;
            color: #fff !important;
            padding: 11px 24px !important;
            border-radius: 10px !important;
            font-weight: 600 !important;
            box-shadow: var(--shadow-glow);
        }
        .cta-nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 40px rgba(0, 141, 218, 0.4) !important;
        }

        /* ============ HERO ============ */
        .hero {
            position: relative;
            height: 100vh;
            min-height: 700px;
            overflow: hidden;
            color: #fff;
            background: var(--primary);
        }
        .hero-slides, .hero-slide { position: absolute; inset: 0; }
        .hero-slide {
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            opacity: 0;
            transform: scale(1.05);
            transition: opacity 1s ease, transform 8s ease;
        }
        .hero-slide.active { opacity: 1; transform: scale(1); }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 20% 50%, rgba(0, 141, 218, 0.3) 0%, transparent 50%),
                linear-gradient(105deg, rgba(5, 15, 30, 0.96) 0%, rgba(5, 20, 40, 0.85) 40%, rgba(5, 25, 50, 0.55) 70%, rgba(5, 25, 50, 0.35) 100%);
            z-index: 2;
        }
        .hero-bg-grid {
            position: absolute;
            inset: 0;
            z-index: 1;
            background-image:
                linear-gradient(rgba(65, 201, 226, 0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(65, 201, 226, 0.06) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
            -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
        }
        .hero-container {
            position: relative;
            z-index: 3;
            max-width: 1280px;
            height: 100%;
            margin: 0 auto;
            display: flex;
            align-items: center;
            padding: 120px 28px 220px;
        }
        .hero-content { max-width: 780px; animation: fadeUp 1s ease both; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            background: rgba(65, 201, 226, 0.12);
            border: 1px solid rgba(65, 201, 226, 0.35);
            border-radius: 100px;
            font-size: 13px;
            font-weight: 600;
            color: #41C9E2;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 28px;
            backdrop-filter: blur(10px);
        }
        .hero-badge .pulse {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #41C9E2;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(65, 201, 226, 0.7); }
            70% { box-shadow: 0 0 0 12px rgba(65, 201, 226, 0); }
            100% { box-shadow: 0 0 0 0 rgba(65, 201, 226, 0); }
        }
        .hero-content h1 {
            font-size: clamp(42px, 5vw, 68px);
            line-height: 1.05;
            margin-bottom: 26px;
            font-weight: 800;
            letter-spacing: -0.03em;
            text-shadow: 0 4px 30px rgba(0,0,0,0.3);
        }
        .hero-content h1 .gradient-text {
            background: linear-gradient(135deg, #41C9E2 0%, #008DDA 50%, #667eea 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            display: block;
        }
        .hero-content p {
            font-size: 18px;
            line-height: 1.7;
            margin-bottom: 40px;
            color: rgba(255, 255, 255, 0.85);
            max-width: 640px;
        }
        .hero-buttons { display: flex; gap: 16px; flex-wrap: wrap; }

        .btn-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--gradient-1);
            color: #fff;
            padding: 17px 32px;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            border-radius: 12px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0, 141, 218, 0.4);
        }
        .btn-main:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 141, 218, 0.5); }
        .btn-main i { transition: transform 0.3s ease; }
        .btn-main:hover i { transform: translateX(4px); }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 17px 30px;
            background: rgba(255, 255, 255, 0.06);
            border: 1.5px solid rgba(255, 255, 255, 0.25);
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            border-radius: 12px;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }
        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.5);
            transform: translateY(-3px);
        }

        .hero-arrow {
            position: absolute;
            z-index: 5;
            top: 50%;
            transform: translateY(-50%);
            width: 52px;
            height: 52px;
            border: 1.5px solid rgba(255, 255, 255, 0.35);
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.25);
            backdrop-filter: blur(10px);
            color: #fff;
            font-size: 26px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        .hero-arrow:hover {
            background: var(--gradient-1);
            border-color: transparent;
            transform: translateY(-50%) scale(1.1);
        }
        .hero-arrow.prev { left: 30px; }
        .hero-arrow.next { right: 30px; }

        .hero-dots {
            position: absolute;
            z-index: 5;
            bottom: 160px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
        }
        .hero-dot {
            width: 32px;
            height: 4px;
            border-radius: 4px;
            border: none;
            background: rgba(255, 255, 255, 0.3);
            cursor: pointer;
            transition: all 0.4s ease;
        }
        .hero-dot.active {
            width: 48px;
            background: var(--gradient-1);
        }

        .ribbon {
            position: absolute;
            z-index: 6;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(5, 15, 30, 0.75);
            backdrop-filter: blur(20px);
            padding: 26px 28px;
            border-top: 1px solid rgba(65, 201, 226, 0.15);
        }
        .ribbon-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            max-width: 1280px;
            margin: 0 auto;
        }
        .ribbon-item {
            min-height: 60px;
            padding: 0 28px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }
        .ribbon-item:last-child { border-right: 0; }
        .ribbon-item h3 {
            font-size: 16px;
            color: #fff;
            font-weight: 600;
            margin-bottom: 3px;
            display: flex;
            align-items: center;
        }
        .ribbon-item p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 12px;
            padding-left: 48px;
        }
        .ribbon-icon {
            flex: 0 0 34px;
            width: 34px;
            height: 34px;
            margin-right: 14px;
            border: 1.5px solid rgba(65, 201, 226, 0.6);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #41C9E2;
            background: rgba(65, 201, 226, 0.08);
        }

        /* ============ SECTIONS ============ */
        section { padding: 120px 28px; position: relative; }
        .container { max-width: 1280px; margin: 0 auto; }

        .section-header { text-align: center; margin-bottom: 80px; }
        .section-tag {
            display: inline-block;
            padding: 7px 18px;
            background: rgba(0, 141, 218, 0.08);
            color: var(--accent);
            border-radius: 100px;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 18px;
        }
        .section-header h2 {
            font-size: clamp(32px, 4vw, 48px);
            color: var(--primary);
            font-weight: 700;
            margin-bottom: 18px;
            letter-spacing: -0.03em;
            line-height: 1.15;
        }
        .section-header p {
            color: var(--text-muted);
            font-size: 17px;
            max-width: 620px;
            margin: 0 auto;
            line-height: 1.65;
        }

        /* SOLUTIONS */
        #solutions {
            background:
                radial-gradient(circle at 0% 0%, rgba(0, 141, 218, 0.04) 0%, transparent 50%),
                radial-gradient(circle at 100% 100%, rgba(102, 126, 234, 0.04) 0%, transparent 50%),
                var(--bg-light);
        }
        .solutions-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
        }
        .solution-card {
            position: relative;
            background: #ffffff;
            padding: 38px 30px;
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-md);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
            min-height: 280px;
            display: flex;
            flex-direction: column;
        }
        .solution-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--gradient-1);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s ease;
        }
        .solution-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 60px rgba(0, 141, 218, 0.15);
            border-color: rgba(0, 141, 218, 0.2);
        }
        .solution-card:hover::before { transform: scaleX(1); }
        .solution-icon-wrap {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: linear-gradient(135deg, rgba(0, 141, 218, 0.1) 0%, rgba(65, 201, 226, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 22px;
            color: var(--icon-color, #008DDA);
            transition: all 0.4s ease;
        }
        .solution-card:hover .solution-icon-wrap { transform: scale(1.08) rotate(-3deg); }
        .solution-icon-wrap svg {
            width: 28px;
            height: 28px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .solution-icon-wrap .icon-emoji { font-size: 26px; }
        .solution-card .num {
            font-size: 11px;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin-bottom: 10px;
        }
        .solution-card h3 {
            color: var(--primary);
            font-size: 20px;
            line-height: 1.3;
            margin-bottom: 12px;
            font-weight: 700;
        }
        .solution-card p {
            color: var(--text-muted);
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 16px;
            flex-grow: 1;
        }
        .solution-tags {
            padding-top: 14px;
            border-top: 1px solid var(--border);
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .solution-tags .tag-item {
            color: var(--accent);
            background: rgba(0, 141, 218, 0.08);
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
        }
        @media (max-width: 1000px) { .solutions-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 620px) { .solutions-grid { grid-template-columns: 1fr; } .solution-card { min-height: auto; } }

        /* ABOUT */
        .about-bg { background: var(--white); }
        .about-split {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 80px;
            align-items: center;
        }
        .about-content .section-tag { margin-bottom: 20px; }
        .about-content h3 {
            font-size: clamp(28px, 3.5vw, 40px);
            color: var(--primary);
            margin-bottom: 24px;
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1.15;
        }
        .about-content p {
            color: var(--text-muted);
            margin-bottom: 20px;
            font-size: 16px;
            line-height: 1.75;
        }
        .about-content strong { color: var(--primary); font-weight: 600; }
        .about-image-wrap {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }
        .about-image-wrap img {
            width: 100%;
            display: block;
            border-radius: 24px;
            transition: transform 0.6s ease;
        }
        .about-image-wrap:hover img { transform: scale(1.05); }

        /* CONTACT */
        #contact {
            background:
                radial-gradient(circle at 100% 0%, rgba(0, 141, 218, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 0% 100%, rgba(102, 126, 234, 0.05) 0%, transparent 40%),
                var(--bg-light);
        }
        .contact-split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 60px; align-items: start; }
        .contact-meta .section-tag { margin-bottom: 20px; }
        .contact-meta h3 {
            font-size: clamp(28px, 3.5vw, 40px);
            color: var(--primary);
            margin-bottom: 20px;
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1.15;
        }
        .contact-meta > p { color: var(--text-muted); margin-bottom: 40px; font-size: 16px; line-height: 1.7; }
        .meta-detail {
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 22px;
            background: #fff;
            border-radius: 14px;
            border: 1px solid var(--border);
            transition: all 0.3s ease;
        }
        .meta-detail:hover {
            transform: translateX(6px);
            border-color: rgba(0, 141, 218, 0.3);
            box-shadow: 0 10px 30px rgba(0, 141, 218, 0.08);
        }
        .meta-detail .contact-icon-wrap {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(0, 141, 218, 0.1) 0%, rgba(65, 201, 226, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
        }
        .meta-detail .contact-icon-wrap svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .meta-detail-text strong {
            display: block;
            font-size: 12px;
            text-transform: uppercase;
            color: var(--accent);
            letter-spacing: 0.8px;
            font-weight: 600;
            margin-bottom: 3px;
        }
        .meta-detail-text span { font-size: 15px; color: var(--primary); font-weight: 500; }

        form {
            background: #ffffff;
            padding: 44px;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.07);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }
        form::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-1);
        }
        .form-group { display: flex; flex-direction: column; gap: 8px; }
        .span-2 { grid-column: span 2; }
        form label { font-weight: 600; font-size: 13px; color: var(--primary); }
        form input, form select, form textarea {
            width: 100%;
            padding: 14px 16px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            background: #fff;
            font-size: 15px;
            font-family: inherit;
            color: var(--text-dark);
            transition: all 0.25s ease;
        }
        form input:focus, form select:focus, form textarea:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(0, 141, 218, 0.08);
        }
        form button {
            grid-column: span 2;
            background: var(--gradient-1);
            color: white;
            border: none;
            padding: 17px;
            font-weight: 700;
            font-size: 15px;
            border-radius: 10px;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0, 141, 218, 0.35);
        }
        form button:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 141, 218, 0.5); }

        /* ============ FOOTER ============ */
        footer {
            background: var(--gradient-2);
            color: #94A3B8;
            padding: 70px 28px 30px;
            position: relative;
            overflow: hidden;
        }
        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(65, 201, 226, 0.5), transparent);
        }
        .footer-grid {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1fr;
            gap: 50px;
            padding-bottom: 50px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .footer-brand .footer-logo {
            display: inline-block;
            margin-bottom: 18px;
            background: #ffffff;
            padding: 8px 14px;
            border-radius: 10px;
        }
        .footer-brand .footer-logo img {
            height: 36px;
            display: block;
        }
        .footer-brand p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            line-height: 1.7;
            max-width: 320px;
        }
        .footer-col h4 {
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 12px;
        }
        .footer-col h4::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 32px;
            height: 2px;
            background: var(--gradient-1);
            border-radius: 2px;
        }
        .footer-col a {
            display: block;
            color: rgba(255, 255, 255, 0.65);
            text-decoration: none;
            font-size: 14px;
            padding: 7px 0;
            transition: all 0.25s ease;
        }
